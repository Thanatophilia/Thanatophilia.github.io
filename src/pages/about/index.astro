---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { config } from '@/site-config'
---

<BaseLayout title="关于" description={`关于 ${config.site.author}`}>
  <div class="animate mx-auto max-w-3xl">
    <header class="not-prose mb-8 text-center">
      <h1 class="font-serif text-3xl font-semibold">关于</h1>
      <p class="mt-3 text-ink-soft">{config.site.description}</p>
    </header>

    <div class="prose prose-fill">
      <h2>关于我</h2>
      {
        config.home.hero.about
          .split(/\n\s*\n/)
          .filter(Boolean)
          .map((paragraph) => <p>{paragraph}</p>)
      }

      <h2>关于本站</h2>
      <p>
        「君子书」是一个刚起步的个人博客。用 <strong>Astro</strong> 搭建，基于
        <strong>astro-theme-ink</strong> 主题，托管在 GitHub Pages 上。
      </p>
      <blockquote>君子欲讷于言而敏于行。——《论语·里仁》</blockquote>

      <h2>联系我</h2>
      <p>
        你可以在 <a href="https://github.com/Thanatophilia">GitHub</a> 找到我，也欢迎通过
        <a href={config.header.menu.find((m) => m.link === '/links')?.link ?? '/'}>友链</a>
        页面交换链接。
      </p>
    </div>
  </div>
</BaseLayout>
